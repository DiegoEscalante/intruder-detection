# =====================================================
# Environment Secrets & Local Data (CRITICAL: NEVER COMMIT)
# =====================================================
.env
*.env
.env.*
*.env.backup
!*.env.example

# Local SQLite databases & local runtime data
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.backup
back/data/*.db
back/data/*.db-journal

# Captured surveillance evidence
back/evidence/*
!back/evidence/.gitkeep

# =====================================================
# Python & Virtual Environments
# =====================================================
.venv/
venv/
env/
ENV/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# =====================================================
# Node.js & React Native / Expo Mobile
# =====================================================
node_modules/
front/node_modules/
.expo/
front/.expo/
npm-debug.*
yarn-debug.*
yarn-error.*

# =====================================================
# Android Native Build Outputs & Gradle Cache
# =====================================================
front/android/.gradle/
front/android/build/
front/android/app/build/
front/android/local.properties
front/android/.cxx/
front/android/*.iml
front/android/app/*.iml

# =====================================================
# PlatformIO & Embedded Firmware (ESP32)
# =====================================================
.pio/
esp32-cam/.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

