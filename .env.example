# =====================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (FastAPI / Uvicorn)
# =====================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Dirección IP local de la computadora (LAN) que el ESP32 debe alcanzar
# Si se deja vacío o no se define, el backend la detecta automáticamente.
# ADVERTISED_IP=192.168.1.50

# =====================================================
# PROTOCOLO DE DESCUBRIMIENTO UDP (ESP32-CAM Handshake)
# =====================================================
UDP_LISTEN_PORT=4210
ESP32_RESPONSE_PORT=4211

# =====================================================
# SERVICIO DE CORREO ELECTRÓNICO (ALERTAS CRÍTICAS SMTP)
# Para Gmail, genera una "Contraseña de aplicación" en:
# https://myaccount.google.com/apppasswords
# =====================================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_aqui
ALERT_RECIPIENT=correo_del_propietario@ejemplo.com

# Tiempos de Cooldown (segundos) para evitar saturación de correo y ráfagas
ALERT_COOLDOWN_SECONDS=60
PERSON_COOLDOWN_SECONDS=30

# =====================================================
# RUTAS DE ALMACENAMIENTO LOCAL Y PERSISTENCIA
# =====================================================
EVIDENCE_DIR=./evidence
DATABASE_PATH=./data/intruder.db
