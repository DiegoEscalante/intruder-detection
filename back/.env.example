# =====================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND
# =====================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# =====================================================
# DESCUBRIMIENTO UDP (ESP32-CAM)
# =====================================================
UDP_LISTEN_PORT=4210
ESP32_RESPONSE_PORT=4211

# =====================================================
# SERVICIO DE CORREO ELECTRÓNICO (ALERTAS CRÍTICAS)
# Configura un correo SMTP (por ejemplo Gmail con contraseña de aplicación)
# =====================================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
ALERT_RECIPIENT=tu_correo@gmail.com

# Tiempo mínimo en segundos entre envíos de correo para evitar saturación
ALERT_COOLDOWN_SECONDS=60

# =====================================================
# ALMACENAMIENTO DE EVIDENCIA
# =====================================================
EVIDENCE_DIR=./evidence
DATABASE_PATH=./data/intruder.db
