{
  "expo": {
    "name": "Sentinel ESP32 Security",
    "slug": "sentinel-esp32-security",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f8f9ff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sentinel.esp32security",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "WAKE_LOCK"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "8b3eefcf-0a8e-4c70-b6a6-a9a015a1fe17"
      }
    }
  }
}
